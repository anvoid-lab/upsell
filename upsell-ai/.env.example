# LLM Configuration
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=your model name
LLM_API_KEY=your api key

# Embedding Configuration
LLM_EMBED_URL=http://localhost:11434/v1
LLM_EMBED_MODEL=embeddinggemma
LLM_EMBED_API_KEY=ollama

# External Supabase project at ../supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-secret-key

# Redis context cache
REDIS_URL=redis://localhost:6379/0
CONTEXT_TTL_SECONDS=1800
IDEMPOTENCY_TTL_SECONDS=86400

# Server
API_HOST=0.0.0.0
API_PORT=8000

# Smoke suite. The server, Redis, and migrated Supabase project must already be running.
UPSELL_API_BASE=http://localhost:8000
E2E_TENANT_ID=
E2E_ACTOR_ID=
E2E_CUSTOMER_ID=
E2E_OTHER_TENANT_ID=