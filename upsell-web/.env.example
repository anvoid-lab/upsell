# Copy to .env.local and fill in the values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase key. Used by webhooks and seed; bypasses RLS.
SUPABASE_SECRET_KEY=

# Server-only inbox provider configuration.
INBOX_PROVIDER=unipile
UNIPILE_API_URL=
UNIPILE_API_KEY=

# Shared header for POST /inbox/webhooks/channel.
# Generate separate random values for both secrets, e.g. openssl rand -hex 32.
UNIPILE_WEBHOOK_SECRET=

# Signs temporary Hosted Auth state. At least 32 characters.
INBOX_HOSTED_AUTH_SECRET=

# Public HTTPS application URL, without a trailing slash.
APP_URL=

# Optional development seed account.
SEED_DEV_EMAIL=
SEED_DEV_PASSWORD=
