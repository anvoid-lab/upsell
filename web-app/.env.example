# Copiar para .env.local e preencher.

# ─── Supabase ─────────────────────────────────────────────────
# Project Settings → API, no dashboard do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Chave secreta (apenas servidor) ──────────────────────────
# Project Settings → API Keys → chave `secret` (sb_secret_...).
#
# Ignora o RLS por completo. NUNCA prefixar com NEXT_PUBLIC_ — isso
# publicaria acesso irrestrito à base de dados no bundle do browser.
#
# Usada só por `npm run seed`: as políticas RLS da migração 003 confinam cada
# tenant ao seu business e não existe política para `anon`, por isso a chave
# publishable não consegue semear dados.
SUPABASE_SECRET_KEY=

# ─── Serviço de inferência (ml/) ──────────────────────────────
# A geração de respostas não acontece aqui: o web-app fala com o serviço
# Python em `ml/`, que faz o RAG e chama o LLM. Estas variáveis são só o
# endereço e a autenticação desse serviço.
#
# AI_INFERENCE_API_KEY é server-only. NUNCA prefixar com NEXT_PUBLIC_.
AI_INFERENCE_URL=
AI_INFERENCE_API_KEY=

# `ml/` ainda não existe. Com AI_MOCK_MODE=true, generate() responde com dados
# simulados (mas validados pelo mesmo contrato) e nem exige as duas variáveis
# acima. Desliga isto (ou remove) assim que `ml/` estiver a responder de verdade.
AI_MOCK_MODE=true

# ─── Webhook de canais ────────────────────────────────────────
# A rota /api/webhooks/channel é pública: quem a chama é o provider
# (WhatsApp/Instagram/Facebook), que não traz sessão nenhuma. A autenticação
# dela é a assinatura HMAC — daí este segredo ser a única coisa entre a
# internet e a escrita de mensagens na base de dados.
#
# Server-only. NUNCA prefixar com NEXT_PUBLIC_.
# Gerar com: openssl rand -hex 32
CHANNEL_WEBHOOK_SECRET=

# Token que o provider envia no handshake de verificação (GET) e que a rota
# devolve no `hub.challenge`. Também server-only.
CHANNEL_VERIFY_TOKEN=

# ─── Fila de sugestões (pgmq + pg_cron) ────────────────────────
# /api/jobs/drain-suggestions é chamado pelo pg_cron (migração 008), não por
# um utilizador — este segredo é a autenticação entre os dois. Em produção,
# o pg_cron lê o mesmo valor via Supabase Vault (ver a migração); localmente,
# scripts/drain-suggestions.sh lê-o daqui.
#
# Server-only. NUNCA prefixar com NEXT_PUBLIC_.
# Gerar com: openssl rand -hex 32
INTERNAL_JOBS_SECRET=

# ─── Utilizador de desenvolvimento (opcional) ─────────────────
# Se definidas, `npm run seed` cria (ou repõe a password de) este utilizador
# e liga-o ao business semeado — sem isto, um ambiente novo não tem forma de
# entrar nos dados que o seed acabou de inserir. Deixar vazio salta este passo.
SEED_DEV_EMAIL=
SEED_DEV_PASSWORD=
