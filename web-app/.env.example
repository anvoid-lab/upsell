# Copiar para .env.local e preencher.

# ─── Supabase ─────────────────────────────────────────────────
# Project Settings → API, no dashboard do Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Sessão ───────────────────────────────────────────────────
# Chave de assinatura do cookie vendai_session (JWT HS256).
# Mínimo 32 caracteres. Gerar com:  openssl rand -base64 32
# A app rebenta no arranque se estiver em falta — não há valor por omissão.
SESSION_SECRET=
